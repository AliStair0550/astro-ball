; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Astro Ball"
config/description="Break through the asteroid fields of The Drift."
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon_1024.png"

[autoload]

GameSettings="*res://scripts/settings.gd"
GameProgress="*res://scripts/progress.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[physics]

; Fixed timestep, interpolated for display. A 120 Hz phone renders twice
; per physics tick, and nothing in the game may depend on frame rate.
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

; Required by iOS. Godot refuses to export without it.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027451, 0.027451, 0.047059, 1)
