; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Astro Ball"
config/description="Break through the asteroid fields of The Drift."
config/version="1.0"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon_1024.png"

; No engine logo on the way in. The boot screen is painted in the same
; void as the game's own sky, so launching is one continuous darkness
; that the star field arrives out of, not a grey card with a logo on it.
boot_splash/bg_color=Color(0.027451, 0.027451, 0.047059, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/minimum_display_time=0

[autoload]

GameSettings="*res://scripts/settings.gd"
GameProgress="*res://scripts/progress.gd"
GameSession="*res://scripts/session.gd"
GameCenterLink="*res://scripts/game_center.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

; One tap is one press. With this on, a touch also produces a mouse
; press at the same point, and a screen that relays itself out between
; the two hands the second press to whatever button has moved under the
; finger. Touch and mouse are both handled explicitly; neither needs the
; engine to invent the other.
pointing/emulate_mouse_from_touch=false

[physics]

; Fixed timestep, interpolated for display. A 120 Hz phone renders twice
; per physics tick, and nothing in the game may depend on frame rate.
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

; Required by iOS. Godot refuses to export without it.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027451, 0.027451, 0.047059, 1)
